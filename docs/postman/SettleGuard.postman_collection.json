{
  "info": {
    "name": "SettleGuard webhooks and UPI",
    "description": "Signed webhook deliveries, failure cases and debugging calls. Set baseUrl, webhook_secret (same as the server's WEBHOOK_SECRET) and admin_token (only if WEBHOOK_ADMIN_TOKEN is set). Run the folders in order.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Webhook receiver",
      "item": [
        {
          "name": "Payment authorized (200, processed)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Razorpay-Event-Id",
                "value": "pm_evt_1"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/webhooks/payments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "webhooks",
                "payments"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\"entity\":\"event\",\"event\":\"payment.authorized\",\"created_at\":1,\"payload\":{\"payment\":{\"entity\":{\"id\":\"pay_pm_1\",\"order_id\":\"order_pm_1\",\"amount\":50000,\"currency\":\"INR\",\"method\":\"upi\"}}}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Sign the exact raw body with the webhook secret (HMAC-SHA256, hex).",
                  "const body = pm.request.body.raw;",
                  "const sig = CryptoJS.HmacSHA256(body, pm.environment.get('webhook_secret')).toString(CryptoJS.enc.Hex);",
                  "pm.request.headers.upsert({key: 'X-Razorpay-Signature', value: sig});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('processed', () => pm.expect(pm.response.json().status).to.eql('processed'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Payment captured (200, processed)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
