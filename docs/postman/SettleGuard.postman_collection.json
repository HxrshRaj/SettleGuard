              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "webhooks",
                "payments"
              ]
            },
            "description": "Gateways redeliver. The same event id must not be applied twice.",
            "body": {
              "mode": "raw",
              "raw": "{\"entity\":\"event\",\"event\":\"payment.captured\",\"created_at\":2,\"payload\":{\"payment\":{\"entity\":{\"id\":\"pay_pm_1\",\"order_id\":\"order_pm_1\",\"amount\":50000,\"currency\":\"INR\",\"method\":\"upi\"}}}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Sign the exact raw body with the webhook secret (HMAC-SHA256, hex).",
                  "const body = pm.request.body.raw;",
                  "const sig = CryptoJS.HmacSHA256(body, pm.environment.get('webhook_secret')).toString(CryptoJS.enc.Hex);",
                  "pm.request.headers.upsert({key: 'X-Razorpay-Signature', value: sig});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('duplicate', () => pm.expect(pm.response.json().duplicate).to.eql(true));"
                ]
              }
            }
          ]
        },
