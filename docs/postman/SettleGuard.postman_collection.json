    {
      "name": "3. UPI and validation",
      "item": [
        {
          "name": "Validate a VPA",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/india/validate/vpa",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "india",
                "validate",
                "vpa"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\"value\":\"merchant@okbank\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Create a UPI collect request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/india/upi/collect",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "india",
                "upi",
                "collect"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\"payer\":\"customer@okbank\",\"payee\":\"merchant@okbank\",\"amount\":\"499.00\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Build a UPI intent link",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/india/upi/intent",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "india",
                "upi",
                "intent"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\"vpa\":\"merchant@okbank\",\"name\":\"Demo Store\",\"amount\":\"250.00\",\"txn_ref\":\"ORD1001\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    }
