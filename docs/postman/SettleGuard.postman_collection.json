                ]
              }
            }
          ]
        },
        {
          "name": "Same event again (200, duplicate)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Razorpay-Event-Id",
                "value": "pm_evt_2"
